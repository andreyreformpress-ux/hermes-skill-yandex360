{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "yandex360_mail": {
      "type": "streamable-http",
      "url": "https://mcp.360.yandex.net/v1/mail/mcp",
      "headers": {
        "Authorization": "Bearer ${YANDEX360_MAIL_API_KEY}"
      }
    },
    "yandex360_calendar": {
      "type": "streamable-http",
      "url": "https://mcp.360.yandex.net/v1/calendar/mcp",
      "headers": {
        "Authorization": "OAuth ${YANDEX360_CALENDAR_API_KEY}"
      }
    },
    "yandex360_telemost": {
      "type": "streamable-http",
      "url": "https://mcp.360.yandex.net/v1/telemost/mcp",
      "headers": {
        "Authorization": "OAuth ${YANDEX360_TELEMOST_API_KEY}"
      }
    }
  }
}
